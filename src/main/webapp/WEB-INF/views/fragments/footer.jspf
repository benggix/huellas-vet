<%-- Este fragmento footer jspf sera el pie de pagina comun para todas las vistas, incluyendo el bloque de suscripcion a la newsletter --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<section class="newsletter" id="newsletter" aria-labelledby="newsletterTitle">
  <div class="newsletter__inner">
    <div class="newsletter__copy">
      <span class="eyebrow">Correo mensual</span>
      <h2 id="newsletterTitle">Tips de cuidado animal, directo a tu casilla.</h2>
      <p>Una vez al mes: novedades de la clínica, vacunas de temporada y consejos breves para perros, gatos, conejos, hurones y cobayos.</p>
    </div>

    <%-- action que apunta al Servlet/controlador de suscripcion (/suscripcion) --%>
    <form class="newsletter__form" action="${pageContext.request.contextPath}/suscripcion" method="post" novalidate>
      <input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}" />
      <label for="newsletterEmail" class="sr-only">Correo electrónico</label>
      <input type="email" id="newsletterEmail" name="email" placeholder="tu@correo.com" required />
      <button type="submit" class="btn btn--honey">Suscribirme</button>
      <c:if test="${not empty resultadoNewsletter}">
        <p class="form-msg ${resultadoNewsletter.ok ? 'is-ok' : 'is-error'}" role="status">${resultadoNewsletter.mensaje}</p>
      </c:if>
      <p class="form-msg" id="newsletterMsg" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <svg class="brand__mark" viewBox="0 0 48 48" width="32" height="32" aria-hidden="true">
        <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="2"/>
        <ellipse cx="24" cy="29" rx="9" ry="7" fill="currentColor"/>
        <ellipse cx="14" cy="17" rx="3.6" ry="4.6" fill="currentColor"/>
        <ellipse cx="34" cy="17" rx="3.6" ry="4.6" fill="currentColor"/>
        <ellipse cx="16.5" cy="24.5" rx="3.2" ry="4" fill="currentColor"/>
        <ellipse cx="31.5" cy="24.5" rx="3.2" ry="4" fill="currentColor"/>
      </svg>
      <p>Clínica Veterinaria Huellas<br/>La Plata, Buenos Aires</p>
    </div>

    <nav class="site-footer__links" aria-label="Enlaces rápidos">
      <h3>Secciones</h3>
      <ul>
        <li><a href="${pageContext.request.contextPath}/index.jsp">Inicio</a></li>
        <li><a href="${pageContext.request.contextPath}/servicios">Servicios</a></li>
        <li><a href="${pageContext.request.contextPath}/turnos">Turnos</a></li>
        <li><a href="${pageContext.request.contextPath}/blog">Blog</a></li>
        <li><a href="${pageContext.request.contextPath}/contacto">Contacto</a></li>
      </ul>
    </nav>

    <div class="site-footer__contact">
      <h3>Contacto</h3>
      <ul>
        <li>Calle 47 n.º 620, La Plata</li>
        <li>Lun a Vie 9–19 h · Sáb 9–13 h</li>
        <li>(0221) 555-0148</li>
      </ul>
    </div>

    <div class="site-footer__social">
      <h3>Seguinos</h3>
      <ul class="social-list">
        <li><a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook de Huellas">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.2h-3V7.7c0-.9.3-1.6 1.6-1.6h1.6V3.2c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.6H7.9V13h2.5v8h3.1z"/></svg>
        </a></li>
        <li><a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram de Huellas">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
        </a></li>
        <li><a href="https://wa.me/5492215550148" target="_blank" rel="noopener" aria-label="WhatsApp de Huellas">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.1a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.1 8.1 0 1 1 12 20.1zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-1.4-.7-2.3-1.3-3.2-2.9-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4-.1-.1-.5-1.3-.7-1.8-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.9 2.2 1 2.3c.1.2 1.7 2.7 4.2 3.7.6.2 1 .4 1.4.5.6.2 1.1.1 1.5-.1.5-.2 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.2-.4-.3z"/></svg>
        </a></li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>© <span id="year"></span> Clínica Veterinaria Huellas. Todos los derechos reservados.</p>
    <p class="site-footer__credit">Proyecto académico — Tecnicatura en Diseño Multimedial y de Sitios Web, FICH-UNL. · <a href="${pageContext.request.contextPath}/admin/login">Acceso interno</a></p>
  </div>
</footer>

<div class="popup" id="welcomePopup" role="dialog" aria-modal="true" aria-labelledby="popupTitle" hidden>
  <div class="popup__card">
    <button type="button" class="popup__close" id="popupClose" aria-label="Cerrar aviso">×</button>
    <span class="stamp stamp--popup" aria-hidden="true">
      <svg viewBox="0 0 60 60" width="56" height="56"><circle cx="30" cy="30" r="27" fill="none" stroke="currentColor" stroke-width="2"/><ellipse cx="30" cy="35" rx="11" ry="8.5" fill="currentColor"/><ellipse cx="18" cy="21" rx="4.3" ry="5.5" fill="currentColor"/><ellipse cx="42" cy="21" rx="4.3" ry="5.5" fill="currentColor"/><ellipse cx="20.5" cy="29" rx="3.8" ry="4.8" fill="currentColor"/><ellipse cx="39.5" cy="29" rx="3.8" ry="4.8" fill="currentColor"/></svg>
    </span>
    <h2 id="popupTitle">Promo del mes</h2>
    <p>Control clínico + vacuna antirrábica con <strong>20% off</strong> para mascotas nuevas en la clínica. Válido durante todo el mes.</p>
    <a href="${pageContext.request.contextPath}/turnos" class="btn btn--honey" id="popupCtaLink">Reservar con descuento</a>
  </div>
  <div class="popup__backdrop" id="popupBackdrop"></div>
</div>

<script src="${pageContext.request.contextPath}/resources/js/main.js"></script>
