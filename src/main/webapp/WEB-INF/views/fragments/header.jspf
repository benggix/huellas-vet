<%-- Este fragmento header jspf sera la cabecera comun para todas las vistas --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:if test="${empty currentPage}">
  <c:set var="currentPage" value="" />
</c:if>

<header class="site-header">
  <div class="site-header__inner">
    <a href="${pageContext.request.contextPath}/index.jsp" class="brand" aria-label="Huellas, inicio">
      <svg class="brand__mark" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true">
        <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="2"/>
        <ellipse cx="24" cy="29" rx="9" ry="7" fill="currentColor"/>
        <ellipse cx="14" cy="17" rx="3.6" ry="4.6" fill="currentColor"/>
        <ellipse cx="34" cy="17" rx="3.6" ry="4.6" fill="currentColor"/>
        <ellipse cx="16.5" cy="24.5" rx="3.2" ry="4" fill="currentColor"/>
        <ellipse cx="31.5" cy="24.5" rx="3.2" ry="4" fill="currentColor"/>
      </svg>
      <span class="brand__word">Huellas<span class="brand__word--sub">Clínica Veterinaria</span></span>
    </a>

    <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="Abrir menú de navegación">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav class="site-nav" id="siteNav" aria-label="Navegación principal">
      <ul class="site-nav__list">
        <li><a href="${pageContext.request.contextPath}/index.jsp" class="${currentPage == 'inicio' ? 'is-active' : ''}">Inicio</a></li>
        <li><a href="${pageContext.request.contextPath}/servicios" class="${currentPage == 'servicios' ? 'is-active' : ''}">Servicios</a></li>
        <li><a href="${pageContext.request.contextPath}/turnos" class="${currentPage == 'turnos' ? 'is-active' : ''}">Turnos</a></li>
        <li><a href="${pageContext.request.contextPath}/blog" class="${currentPage == 'blog' ? 'is-active' : ''}">Blog</a></li>
        <li><a href="${pageContext.request.contextPath}/contacto" class="${currentPage == 'contacto' ? 'is-active' : ''}">Contacto</a></li>
        <li class="site-nav__cta"><a href="${pageContext.request.contextPath}/turnos" class="btn btn--small">Reservar turno</a></li>
      </ul>
    </nav>
  </div>
</header>
